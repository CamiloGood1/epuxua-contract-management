# ── Supabase ──────────────────────────────────────────────────────────────────
# Proyecto → Settings → API

# URL pública del proyecto Supabase (expuesta en el cliente)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxx.supabase.co

# Clave anon/pública (expuesta en el cliente — solo permite operaciones cubiertas por RLS)
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGci...

# Clave de servicio (SOLO servidor — bypasa RLS, NUNCA exponer en el cliente)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGci...

# ── OpenAI ────────────────────────────────────────────────────────────────────
# Proyecto → API Keys

OPENAI_API_KEY=sk-proj-...

# Opcional: modelo a usar en el Asistente IA (default: gpt-4o-mini)
# OPENAI_ANALYSIS_MODEL=gpt-4o-mini

# ── URL pública de la aplicación ──────────────────────────────────────────────
# Usada en redirects de auth y en reportes.
# En Vercel: VERCEL_URL se inyecta automáticamente en producción.
# En desarrollo local: http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
